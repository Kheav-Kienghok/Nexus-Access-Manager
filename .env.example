# Nexus address, for example https://nexus.example.com
NEXUS_URL=

NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=

# On the Nexus VM, Nexus is only reachable through Caddy:
# connect to 127.0.0.1 but keep the name from NEXUS_URL, and trust the Caddy CA
NEXUS_RESOLVE=
NEXUS_CACERT=
NEXUS_INSECURE=

# Repositories and Docker ports (defaults shown)
NEXUS_PULL_REPO=docker-all
NEXUS_PUSH_REPO=docker-hosted
NEXUS_PYPI_REPO=pypi-all
NEXUS_PULL_PORT=5000
NEXUS_PUSH_PORT=5002
NEXUS_EMAIL_DOMAIN=example.com
